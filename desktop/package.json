{
  "name": "basic-chatting-desktop",
  "version": "2.0.0",
  "description": "Basic Chatting 桌面应用 — 跨设备实时聊天",
  "main": "main.js",
  "author": "HuHuBasic",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux AppImage",
    "build:all": "electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "com.basic.chatting",
    "productName": "Basic Chatting",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "icon.png"],
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "Network"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}